# Copy this file to .env, then set the required credentials and any optional
# provider settings. Environment variables override values in these files.

# Required cellar administrator credentials
CELLAR_USERNAME=
CELLAR_PASSWORD=
CELLAR_SESSION_SECRET=
CELLAR_ADMIN_EMAIL=cellar@local
WINE_APP_TTL_DAYS=30
# Optional: overrides WINE_APP_TTL_DAYS when set.
# CELLAR_SESSION_TTL_HOURS=12
PASSWORD_RESET_TTL_HOURS=1
ACCOUNT_ACTIVATION_TTL_HOURS=48
CELLAR_COOKIE_SECURE=false

# Storage. Relative paths are resolved from the wine-app directory.
WINE_APP_DATA_DIR=.
# Leave unset to store the database in WINE_APP_DATA_DIR/wine_cellar.db.
# CELLAR_DATABASE_URL=sqlite:///./wine_cellar.db
# Optional individual path overrides; otherwise each is stored in the data directory.
# WINE_LABELS_DIR=wine-labels
# WINE_EMAIL_LOG_FILE=sent_emails.log
# ENRICHMENT_CACHE_FILE=enrichment_cache.json
# ENRICHMENT_USAGE_FILE=enrichment_usage.json
# WINE_QR_LABELS_DIR=wine-bottle-QR-codes
WINE_LABEL_MAX_SIZE_MB=10

# Public address included in account emails and generated bottle QR codes.
# Leave empty to use the current request address for QR codes and localhost for email.
WINE_APP_BASE_URL=

# Optional vision providers
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_SECONDS=120
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
CLOUD_VISION_TIMEOUT_SECONDS=60

# Optional wine catalog providers
GRAPEMINDS_API_KEY=
GRAPEMINDS_BASE_URL=https://api.grapeminds.eu/public/v1
GRAPEMINDS_MOCK_MODE=false
GRAPEMINDS_MONTHLY_LIMIT=200
WINEAPIIO_KEY=
WINEAPIIO_BASE_URL=https://api.wineapi.io
WINEAPIIO_REQUESTS_PER_DAY=100
CATALOG_TIMEOUT_SECONDS=15

# Optional SMTP delivery; when SMTP_HOST is empty, messages are logged locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cellar@local
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
